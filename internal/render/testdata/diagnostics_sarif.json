                  "endColumn": 14,
                  "snippet": {
                    "text": "var 名前, ユーザー名 = \"名\", \"🎉 party\""
                  }
                }
              }
            }
          ]
        },
        {
          "ruleId": "revive",
          "ruleIndex": 1,
