    internal/protocol/mapper.go               -> internal/gopls/protocol/mapper.go
    internal/protocol/mapper_test.go          -> internal/gopls/protocol/mapper_test.go
    internal/protocol/span.go                 -> internal/gopls/protocol/span.go
    internal/protocol/edits.go                -> internal/gopls/protocol/edits.go
    internal/protocol/tsdocument_changes.go   -> internal/gopls/protocol/tsdocument_changes.go
    internal/protocol/uri.go                  -> internal/gopls/protocol/uri.go
